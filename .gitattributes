# 统一行尾：本工程面向 Linux / WSL2，shell 脚本必须是 LF，
# 否则在 Windows 上 clone 后再从 /mnt/d 进 WSL 执行会报 $'\r': command not found
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# 二进制产物：不做行尾转换、不做 diff
*.jpg   binary
*.png   binary
*.pt    binary
*.onnx  binary
*.om    binary
*.npz   binary
*.npy   binary
